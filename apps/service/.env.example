# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Azure OpenAI Realtime (speech-to-speech) ──────────────────────
# Resource root, without the /openai/... suffix
AZURE_OPENAI_ENDPOINT=
# Realtime model deployment name (e.g. gpt-realtime-2.1)
AZURE_OPENAI_REALTIME_DEPLOYMENT=
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview
# API key (keep secret, never commit)
AZURE_OPENAI_API_KEY=

# ── Azure OpenAI Chat (optional text fallback) ────────────────────
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── Flask server ──────────────────────────────────────────────────
PORT=5001
